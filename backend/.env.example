APP_NAME="SEMARAK ALIYAH XIV 2026"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

# ==============================================================================
# MULTI-PORTAL DUAL CHANNEL ARCHITECTURE (PORT & DOMAIN BERBEDA)
# ==============================================================================
# 1. Konfigurasi Port Berbeda (Digunakan di Lokal / Direct Docker Access):
PUBLIC_PORT=8000
ADMIN_PORT=8001

PUBLIC_URL=http://localhost:8000
ADMIN_URL=http://localhost:8001

# 2. Konfigurasi Domain / Subdomain Berbeda (Digunakan di Server Produksi):
# Isi domain publik dan admin saat dideploy ke VPS/Server produksi:
PUBLIC_DOMAIN=semarak.maswahas.sch.id
ADMIN_DOMAIN=admin-semarak.maswahas.sch.id

# ==============================================================================
# DATABASE CONNECTION (PostgreSQL 18.6 Docker / Local)
# ==============================================================================
DB_CONNECTION=pgsql
DB_HOST=database
DB_PORT=5432
DB_DATABASE=semarak_db
DB_USERNAME=semarak_user
DB_PASSWORD=semarak_secret_pass

# Fallback lokal jika menggunakan MariaDB/MySQL tanpa Docker:
# DB_CONNECTION=mariadb
# DB_HOST=127.0.0.1
# DB_PORT=3307
# DB_DATABASE=semarak_db
# DB_USERNAME=root
# DB_PASSWORD=

# ==============================================================================
# CACHE, SESSION, & QUEUE (Redis Alpine)
# ==============================================================================
CACHE_STORE=redis
CACHE_PREFIX=semarak_cache_
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ==============================================================================
# OCTANE RUNTIME SERVER (FrankenPHP)
# ==============================================================================
OCTANE_SERVER=frankenphp

# ==============================================================================
# WEBSOCKET REALTIME BROADCASTING (Laravel Reverb)
# ==============================================================================
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=semarak-app
REVERB_APP_KEY=semarak-key-2026
REVERB_APP_SECRET=semarak-secret-super-secure
REVERB_HOST=localhost
REVERB_PORT=8085
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ==============================================================================
# LOGGING & MAIL
# ==============================================================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

MAIL_MAILER=log
MAIL_FROM_ADDRESS="panitia@maswahas.sch.id"
MAIL_FROM_NAME="${APP_NAME}"
