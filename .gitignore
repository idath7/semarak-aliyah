# Node dependencies
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Composer dependencies
vendor/
*/vendor/

# Environment files and credentials
.env
.env.*
!.env.example
!backend/.env.example
# Legacy prototype
_legacy_express/

# Laravel Framework and Runtime Caches
backend/storage/*.key
backend/storage/framework/cache/data/*
!backend/storage/framework/cache/data/.gitignore
backend/storage/framework/sessions/*
!backend/storage/framework/sessions/.gitignore
backend/storage/framework/views/*
!backend/storage/framework/views/.gitignore
backend/storage/logs/*
!backend/storage/logs/.gitignore
backend/public/storage
backend/public/hot

# Database SQL Dumps & SQLite Binaries
database/backups/*.sql
!database/backups/.gitkeep
*.db
*.sqlite
backend/semarak_db

# Operating System & IDE metadata
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Temporary scripts & media
check_page.js
.tempmediaStorage/

# AI Assistant Guidelines (Not part of app runtime)
CLAUDE.md
AGENTS.md
GEMINI.md
*/CLAUDE.md
*/AGENTS.md

